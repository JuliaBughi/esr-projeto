node n1 {
    type router
    model PC
    network-config {
	hostname Bootstrap
	!
	interface eth0
	 ip address 10.0.0.20/24
	 ipv6 address 2001:0::20/64
	!
    }
    canvas c1
    iconcoords {872.0 429.3333333333333}
    labelcoords {872.0 461.3333333333333}
    interface-peer {eth0 n7}
}

node n2 {
    type router
    model host
    network-config {
	hostname Server
	!
	interface eth0
	 ip address 10.0.0.10/24
	 ipv6 address 2001:0::10/64
	!
    }
    canvas c1
    iconcoords {893.3333333333334 242.66666666666666}
    labelcoords {893.3333333333334 274.6666666666667}
    interface-peer {eth0 n7}
}

node n3 {
    type router
    model router
    network-config {
	hostname O4
	!
	interface eth1
	 ip address 10.0.3.1/24
	 ipv6 address 2001:3::1/64
	!
	interface eth0
	 ip address 10.0.0.1/24
	 ipv6 address 2001:0::1/64
	!
    }
    canvas c1
    iconcoords {636.0 374.6666666666667}
    labelcoords {633.3333333333334 408.0}
    interface-peer {eth0 n7}
    interface-peer {eth1 n5}
}

node n4 {
    type router
    model router
    network-config {
	hostname O3
	!
	interface eth0
	 ip address 10.0.0.2/24
	 ipv6 address 2001:0::2/64
	!
	interface eth1
	 ip address 10.0.2.1/24
	 ipv6 address 2001:2::1/64
	!
    }
    canvas c1
    iconcoords {629.3333333333334 174.66666666666666}
    labelcoords {633.3333333333334 212.0}
    interface-peer {eth1 n5}
    interface-peer {eth0 n7}
}

node n5 {
    type router
    model router
    network-config {
	hostname O2
	!
	interface eth2
	 ip address 10.0.4.1/24
	 ipv6 address 2001:4::1/64
	!
	interface eth1
	 ip address 10.0.3.2/24
	 ipv6 address 2001:3::2/64
	!
	interface eth0
	 ip address 10.0.2.2/24
	 ipv6 address 2001:2::2/64
	!
    }
    canvas c1
    iconcoords {400.0 276.0}
    labelcoords {400.0 308.0}
    interface-peer {eth0 n4}
    interface-peer {eth1 n3}
    interface-peer {eth2 n6}
}

node n6 {
    type router
    model PC
    network-config {
	hostname C1
	!
	interface eth0
	 ip address 10.0.4.20/24
	 ipv6 address 2001:4::20/64
	!
    }
    canvas c1
    iconcoords {128.0 277.3333333333333}
    labelcoords {120.0 320.0}
    interface-peer {eth0 n5}
}

node n7 {
    type lanswitch
    network-config {
	hostname n7
	!
    }
    canvas c1
    iconcoords {758.6666666666666 288.0}
    labelcoords {758.6666666666666 312.0}
    interface-peer {e0 n3}
    interface-peer {e1 n1}
    interface-peer {e2 n2}
    interface-peer {e3 n4}
}

link l1 {
    nodes {n3 n7}
    bandwidth 0
}

link l2 {
    nodes {n7 n1}
    bandwidth 0
}

link l3 {
    nodes {n7 n2}
    bandwidth 0
}

link l5 {
    nodes {n4 n5}
    bandwidth 0
}

link l6 {
    nodes {n3 n5}
    bandwidth 0
}

link l7 {
    nodes {n5 n6}
    bandwidth 0
}

link l4 {
    delay 20000
    nodes {n4 n7}
    bandwidth 0
}

canvas c1 {
    name {Canvas1}
}

option global {
    interface_names no
    ip_addresses yes
    ipv6_addresses no
    node_labels yes
    link_labels yes
    show_api no
    background_images no
    annotations yes
    grid yes
    traffic_start 0
}

option session {
}

